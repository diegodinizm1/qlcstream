{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "QLC Stream",
  "version": "0.1.0",
  "identifier": "dev.qlcstream.desktop",
  "build": {
    "frontendDist": "../dist/frontend/browser",
    "devUrl": "http://localhost:4201",
    "beforeDevCommand": "npm run start -- --port 4201",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "QLC Stream",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
