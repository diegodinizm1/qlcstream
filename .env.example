# PostgreSQL (uso local via Docker Compose)
POSTGRES_DB=qlc_stream
POSTGRES_USER=qlc_stream
POSTGRES_PASSWORD=qlc_stream_local

# TMDB: use o "API Read Access Token" (token Bearer longo)
TMDB_API_TOKEN=

# Enderecos internos da rede Docker; nao troque por localhost no Compose
PROWLARR_BASE_URL=http://prowlarr:9696
PROWLARR_API_KEY=
QBITTORRENT_BASE_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# Pasta do computador montada no backend (/data) e qBittorrent (/downloads)
MEDIA_HOST_PATH=./data/media

# Cache do TMDB (opcional; remova ou mantenha os valores padrao)
TMDB_CACHE_MAX_ENTRIES=300
TMDB_CACHE_CATALOG_TTL=10m
TMDB_CACHE_SEARCH_TTL=3m
